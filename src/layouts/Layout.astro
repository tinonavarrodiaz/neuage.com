---
import Menu from "@/components/Menu.astro";
import Head from "@/components/seo/Head.astro";
import '@/scss/main.scss';
---

<!doctype html>
<html lang="en">
	<Head/>
	<body>
    <main>
      <slot />
    </main>
    <Menu/>
    <div class="page-scroll page-1"></div>
    <!-- <div class="page-scroll"></div> -->
	</body>
</html>
<style>
  .page-scroll{
    width: 100vw;
    height: 150vh;
  }
</style>
<script>
  import { isMobile } from '@/libs/isMobile';
  import { gsap, ScrollTrigger } from '@/libs/gsap'
  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', e=>{
    const getScrollBarWidth = () => window.innerWidth - document.documentElement.getBoundingClientRect().width
    console.log(getScrollBarWidth())
    document.documentElement.style.setProperty('--scrollbar', `${getScrollBarWidth()}px`)
    const pos = isMobile() ? 0 : 33.33
    const posSalida = isMobile() ? 100 : 35.33
    const delay = isMobile() ? .5 : 0
    if(!isMobile()){
      gsap.fromTo('.image-1',{
        x: "100vw",
      },{
        x: '83.335vw',
        duration: .8,
        delay: 2,
        // onComplete: ()=> document.documentElement.classList.add('scroll-is-active')
      })
      gsap.to('.scroll',{
        opacity: .75,
        onComplete: ()=> document.documentElement.classList.add('scroll-is-active'),
        delay: 2
      })
    }else{
      gsap.to('.scroll',{
        opacity:1,
        onComplete: ()=> document.documentElement.classList.add('scroll-is-active'),
        delay: .5
      })
    }
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '.page1',   // el contenedor que tiene las 3 imágenes
        start: 'top top',
        // end: '+=2000',            // px de scroll que dura TODA la animación
        pin: true,                // mantiene la sección fija mientras dura
        scrub: .5,
        // markers: true,
        invalidateOnRefresh: true
      }
    })
    tl.to('.image-1',{
      x:0
    },0)
    .to('.image-2',{
      x:`${pos}vw`
    },0)
    .to('.image-3',{
      x:`${pos*2}vw`
    },0)
    .to({},{
      duration: .1
    })
    .to('.image-1',{
      x:`-${posSalida}vw`,
      duration: .5
    },1)
    .to('.image-2',{
      x:`-${posSalida}vw`,
      duration: .5
    },1)
    .to('.image-3',{
      x:`-${posSalida}vw`,
      duration: .5
    },1)
    .to('.Home2',{
      x: '0'
    },1)

  })
</script>
