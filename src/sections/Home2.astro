---
import Logo from "@/components/icons/Logo.astro";
---

<article class="Home2">
  <button class="toggle-menu">Menu</button>
  <div class="Logo2">
    <Logo />
  </div>
  <div class="text-container">
    <h2>The Neuage Advantage</h2>
    <div class="paragraph">
      <h3>White-Glove Project Experience</h3>
      <p>
        Clear communication, organized timelines, and personalized service from
        concept to installation.
      </p>
    </div>
    <div class="paragraph">
      <h3>Precision Meets Design</h3>
      <p>We combine structural performance with architectural aesthetics.</p>
    </div>
    <div class="paragraph">
      <h3>Built in Los Angeles</h3>
      <p>
        Crafted locally for Southern California homes, businesses, and
        designers.
      </p>
    </div>
    <div class="paragraph">
      <h3>Tailored Solutions</h3>
      <p>
        Every project is custom-built to fit the client’s vision, property, and
        lifestyle.
      </p>
    </div>
    <footer class="text-container__footer">
      <h3>Steel Designed to Belong.</h3>
      <p>
        Every project is custom fabricated to enhance both function and visual
        identity, transforming steel into a permanent architectural element.
      </p>
    </footer>
  </div>
</article>
